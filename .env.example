# OpenWatch configuration

# SQLite database path. Override to point at a custom data file.
OPENWATCH_DB=./data/openwatch.db

# REST API host + port
OPENWATCH_HOST=0.0.0.0
OPENWATCH_PORT=8788

# MCP server transport: stdio (default) for Claude Desktop / Code, sse for HTTP clients
MCP_TRANSPORT=stdio
MCP_PORT=8789
